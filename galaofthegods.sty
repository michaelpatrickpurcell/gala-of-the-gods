\tikzset{meander_box/.pic={
\begin{scope}
\clip (-0.5in, -0.5in) rectangle (0.5in, 0.5in);

\draw[line width=0.024in, #1] (-0.05in, 0in) -- (0.25in, 0in);

\draw[line width=0.024in, #1] (0.2in, -0.05in) -- (0.2in, 0.25in);
\draw[line width=0.024in, #1] (0in, 0.05in) -- (0in, -0.25in);

\draw[line width=0.024in, #1] (0.25in, 0.2in) -- (-0.25in, 0.2in);
\draw[line width=0.024in, #1] (-0.05in, -0.2in) -- (0.45in, -0.2in);

\draw[line width=0.024in, #1] (-0.2in, 0.25in) -- (-0.2in, -0.45in);
\draw[line width=0.024in, #1] (0.4in, -0.25in) -- (0.4in, 0.45in);

\draw[line width=0.024in, #1] (0.45in, 0.4in) -- (-0.45in, 0.4in);
\draw[line width=0.024in, #1] (-0.25in, -0.4in) -- (0.45in, -0.4in);

\draw[line width=0.024in, #1, inner sep=0pt] (-0.4in, 0.45in) -- (-0.4in, -0.45in);
\end{scope}
}}

\tikzset{meander_corner/.pic={
\pic[transform shape] at (0,0) {meander_box={#1}};
\pic[transform shape] at (1in, 0) {meander_box={#1}};
\pic[rotate=-90, transform shape] at (0, -1in) {meander_box={#1}}; 
\draw[line width=0.024in, #1] (0.4in, -0.4in) -- (0.6in, -0.4in);
\draw[line width=0.024in, #1] (-0.4in, -0.4in) -- (-0.4in, -0.6in);

\draw[line width=0.024in, #1] (1.4in, -0.4in) -- (1.6in, -0.4in);
\draw[line width=0.024in, #1] (-0.4in, -1.4in) -- (-0.4in, -1.6in);

}}

\tikzset{meander_joint/.pic={
\pic[transform shape] at (-0.5in,0) {meander_box={#1}};
\pic[xscale=-1, transform shape] at (0.5in, 0) {meander_box={#1}};
\draw[line width=0.024in, #1] (0.-0.1in, -0.4in) -- (0.1in, -0.4in);
\draw[line width=0.024in, #1] (-0.9in, -0.4in) -- (-1.1in, -0.4in);
\draw[line width=0.024in, #1] (0.9in, -0.4in) -- (1.1in, -0.4in);
}}


\tikzset{meander_double/.pic={
\pic[transform shape] at (-0.5in,0) {meander_box={#1}};
\pic[transform shape] at (0.5in, 0) {meander_box={#1}};
\draw[line width=0.024in, #1] (-0.1in, -0.4in) -- (0.1in, -0.4in);
}}

\tikzset{meander_quad/.pic={
\pic[transform shape] at (-1in, 0) {meander_double={#1}};
\pic[transform shape] at (1in, 0) {meander_double={#1}};
\draw[line width=0.024in, #1] (-0.1in, -0.4in) -- (0.1in, -0.4in);

}}

\tikzset{meander_frame_large/.pic={
\pic[transform shape] at (-4.5in,6.5in) {meander_corner={#1}};
\pic[xscale=-1, transform shape] at (4.5in,6.5in) {meander_corner={#1}};
\pic[yscale=-1, transform shape] at (-4.5in, -6.5in) {meander_corner={#1}};
\pic[rotate=180, transform shape] at (4.5in, -6.5in) {meander_corner={#1}};

\pic[transform shape] at (0in, 6.5in) {meander_joint={#1}};
\pic[rotate=-90, transform shape] at (-4.5in,0in) {meander_joint={#1}};
\pic[rotate=180, transform shape] at (0in,-6.5in) {meander_joint={#1}};
\pic[rotate=90, transform shape] at (4.5in,0in) {meander_joint={#1}};

\pic[transform shape] at (-2in,6.5in) {meander_double={#1}};
\pic[xscale=-1, transform shape] at (2in, 6.5in) {meander_double={#1}};

\pic[yscale=-1, transform shape] at (-2in,-6.5in) {meander_double={#1}};
\pic[xscale=-1, yscale=-1, transform shape] at (2in, -6.5in) {meander_double={#1}};

\pic[rotate=-90, transform shape] at (-4.5in,3in) {meander_quad={#1}};
\pic[xscale=-1, rotate=90, transform shape] at (-4.5in,-3in) {meander_quad={#1}};

\pic[rotate=-90, yscale=-1, transform shape] at (4.5in,3in) {meander_quad={#1}};
\pic[xscale=-1, yscale=-1, rotate=-90, transform shape] at (4.5in,-3in) {meander_quad={#1}};
}}


